# ANIMEVERSE API configuration
PORT=4000
NODE_ENV=development

# Comma-separated list of browser origins allowed to call the API with credentials.
CLIENT_ORIGINS=http://localhost:5173,http://localhost:4000

# Session secret used for signing the session cookie. Use a long random value.
SESSION_SECRET=replace-with-a-long-random-string

# Session lifetime in days.
SESSION_DAYS=7

# Set to true only when the app is served over HTTPS.
COOKIE_SECURE=false

# SQLite database file (relative paths are resolved from the server folder).
DATABASE_PATH=./data/animeverse.db

# Seed accounts. Change these before exposing the app publicly.
ADMIN_NAME=Aria Vance
ADMIN_EMAIL=admin@animeverse.dev
# Quote passwords that contain "#" so dotenv does not treat the rest as a comment.
ADMIN_PASSWORD="Admin#1234"

DEMO_NAME=Kai Nomura
DEMO_EMAIL=explorer@animeverse.dev
DEMO_PASSWORD="Explore#1234"

# Auto-create schema and seed demo content when the database is empty.
AUTO_SEED=true
