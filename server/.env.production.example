# Production environment for Docker Compose or a VPS.
# Copy to server/.env.production and replace every value. Never commit the copy.
# On Render, set these in the dashboard/blueprint instead, with
# DATABASE_PATH=/var/data/animeverse.db.

NODE_ENV=production
PORT=4000

# Public HTTPS origin that serves the app. Added to the CORS/Origin allowlist.
PUBLIC_ORIGIN=https://animeverse.example.com
CLIENT_ORIGINS=https://animeverse.example.com

# At least 32 characters; generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_DAYS=7

# Keep true when the app is behind HTTPS. Cookies will not be set over plain HTTP.
COOKIE_SECURE=true

# Docker mount path. Use an absolute path on the persistent volume.
DATABASE_PATH=/data/animeverse.db
AUTO_SEED=true

# Seeded once, only when the database is empty. Use strong, unique values.
ADMIN_NAME=Aria Vance
ADMIN_EMAIL=admin@animeverse.example.com
ADMIN_PASSWORD="replace-with-a-strong-admin-password"

DEMO_NAME=Kai Nomura
DEMO_EMAIL=explorer@animeverse.example.com
DEMO_PASSWORD="replace-with-a-strong-member-password"
