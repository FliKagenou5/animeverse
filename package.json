{
  "name": "animeverse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ANIMEVERSE - an interactive anime encyclopedia with power scaling, battles, tier lists and a gallery.",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "db:reset": "npm run db:reset -w server",
    "test": "npm run test -w server",
    "build": "npm run build -w client",
    "start": "npm run start -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
